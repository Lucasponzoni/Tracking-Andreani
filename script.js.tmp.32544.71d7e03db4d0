/* -------------------------- Días hábiles ---------------------------------- */
function calcularDiasHabiles(fechaInicio, fechaFin) {
    let diasHabiles = 0;
    const feriados = [
        '2023-01-01', '2023-02-20', '2023-02-21', '2023-03-24', '2023-04-07',
        '2023-05-01', '2023-05-25', '2023-06-19', '2023-08-21', '2023-10-09',
        '2023-11-20', '2023-12-08', '2023-12-25',
        '2024-01-01', '2024-02-12', '2024-02-13', '2024-03-24', '2024-03-29',
        '2024-05-01', '2024-05-25', '2024-06-17', '2024-08-19', '2024-10-14',
        '2024-11-18', '2024-12-08', '2024-12-25',
        '2025-01-01', '2025-03-03', '2025-03-04', '2025-03-24', '2025-04-02',
        '2025-04-18', '2025-05-01', '2025-05-25', '2025-06-16', '2025-06-20',
        '2025-07-09', '2025-08-18', '2025-10-12', '2025-11-24', '2025-12-08', '2025-12-25',
        '2026-01-01', '2026-02-16', '2026-02-17', '2026-03-24', '2026-04-03',
        '2026-05-01', '2026-05-25', '2026-06-15', '2026-06-20', '2026-07-09',
        '2026-08-17', '2026-10-12', '2026-11-23', '2026-12-08', '2026-12-25'
    ];

    const startDate = new Date(fechaInicio);
    const endDate = new Date(fechaFin);
    const currentDate = new Date(startDate);

    while (currentDate <= endDate) {
        const dayOfWeek = currentDate.getDay();
        const dateString = currentDate.toISOString().split('T')[0];
        if (dayOfWeek !== 0 && dayOfWeek !== 6 && !feriados.includes(dateString)) diasHabiles++;
        currentDate.setDate(currentDate.getDate() + 1);
    }
    return diasHabiles;
}

/* =========================================================================
   PDF · documento limpio (tema claro forzado, diseño propio)
   ========================================================================= */
function buildPdfStepper(stage) {
    const labels = ['Generado', 'En planta', 'En viaje', 'En reparto', 'Entregado'];
    const fill = stage.delivered ? '#10b981' : '#f97316';
    let html = '<div style="display:flex;align-items:flex-start;justify-content:space-between;">';
    for (let i = 0; i < labels.length; i++) {
        const done = i <= stage.index;
        html += `
            <div style="display:flex;flex-direction:column;align-items:center;width:80px;">
                <div style="width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;background:${done ? fill : '#e2e8f0'};color:${done ? '#ffffff' : '#94a3b8'};">${done ? '&#10003;' : ''}</div>
                <div style="margin-top:6px;font-size:9px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;text-align:center;color:${done ? '#0f172a' : '#94a3b8'};">${labels[i]}</div>
            </div>`;
        if (i < labels.length - 1) {
            html += `<div style="flex:1;height:3px;border-radius:2px;margin-top:13px;background:${i < stage.index ? fill : '#e2e8f0'};"></div>`;
        }
    }
    return html + '</div>';
}

function buildPdfElement() {
    if (!lastTracking) return null;
    const { trackingNumber, events, statusMessage, firstDateFormatted, lastDateFormatted, lastEstado } = lastTracking;
    const esc = escapeHtml;
    const stage = deriveStage(events);

    // Acento y textos del hero
    let accent, kicker, title;
    if (stage.delivered) { accent = '#10b981'; kicker = 'Entregado'; title = '¡Envío entregado!'; }
    else if (stage.incident) { accent = '#f43f5e'; kicker = 'Atención'; title = lastEstado || 'Revisar envío'; }
    else {
        accent = '#4f46e5'; kicker = 'En curso';
        title = ['Etiqueta generada', 'En planta Andreani', 'En viaje a destino', 'En reparto', '¡Entregado!'][stage.index];
    }

    let fechaGen = '';
    try { fechaGen = new Date().toLocaleString('es-AR', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch (e) { /* ignore */ }

    const root = document.createElement('div');
    root.style.cssText = [
        'width:760px', 'box-sizing:border-box', 'padding:36px',
        'background:#ffffff', 'color:#0f172a',
        "font-family:'Inter',-apple-system,Segoe UI,Roboto,Arial,sans-serif",
    ].join(';');

    // Filas del historial
    let rows = '';
    for (let i = events.length - 1; i >= 0; i--) {
        const ev = events[i];
        const newest = i === events.length - 1;
        const dot = newest ? '#10b981' : '#4f46e5';
        const detalle = esc(ev.Traduccion || ev.Comentario || '');
        let sucursal = ev.Sucursal || '';
        if (sucursal === 'Sucursal Genérica') sucursal = 'DEPÓSITO CENTRAL NOVOGAR, ROSARIO';
        else if (sucursal === 'Centro De Operaciones' || sucursal === 'Rosario' || sucursal === '9') sucursal = 'PLANTA LOGÍSTICA CORREO ANDREANI, ROSARIO';

        rows += `
        <div style="position:relative;padding:10px 14px 10px 30px;margin-bottom:8px;border-radius:12px;page-break-inside:avoid;background:${newest ? '#ecfdf5' : '#f8fafc'};border:1px solid ${newest ? '#a7f3d0' : '#e2e8f0'};">
            <span style="position:absolute;left:12px;top:15px;width:11px;height:11px;border-radius:50%;background:${dot};box-shadow:0 0 0 3px ${dot}22;"></span>
            <div style="font-size:11px;font-weight:600;color:#64748b;">${esc(formatFecha(ev.Fecha))}</div>
            <div style="display:inline-block;margin:4px 0 2px;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:800;text-transform:uppercase;background:${newest ? '#10b981' : '#e2e8f0'};color:${newest ? '#fff' : '#334155'};">${esc(ev.Estado) || '—'}</div>
            ${detalle ? `<div style="font-size:12px;font-weight:700;color:#4f46e5;text-transform:uppercase;">${detalle}</div>` : ''}
            ${sucursal ? `<div style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;">${esc(sucursal)}</div>` : ''}
        </div>`;
    }

    root.innerHTML = `
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e2e8f0;padding-bottom:16px;">
            <img src="./img/Logo Tracking.png" alt="Tracking" style="height:38px;width:auto;display:block;">
            <div style="text-align:right;">
                <div style="font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#64748b;">Comprobante de seguimiento</div>
                ${fechaGen ? `<div style="font-size:11px;color:#94a3b8;margin-top:2px;">Generado el ${esc(fechaGen)} hs</div>` : ''}
            </div>
        </div>

        <!-- Status hero -->
        <div style="margin-top:20px;border:1px solid #e2e8f0;border-left:6px solid ${accent};border-radius:16px;padding:18px 20px;background:#f8fafc;">
            <div style="font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:${accent};">${esc(kicker)}</div>
            <div style="font-size:23px;font-weight:800;margin:2px 0 8px;">${esc(title)}</div>
            <span style="display:inline-block;background:#fff;border:1px solid #e2e8f0;border-radius:999px;padding:4px 12px;font-size:12px;font-weight:700;color:#334155;">N° ${esc(trackingNumber)}</span>
            ${statusMessage ? `<div style="font-size:13px;font-weight:500;color:#475569;margin-top:10px;line-height:1.5;">${esc(statusMessage)}</div>` : ''}
            <div style="display:flex;gap:10px;margin-top:14px;">
                <div style="flex:1;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:8px 10px;">
                    <div style="font-size:10px;font-weight:800;text-transform:uppercase;color:#94a3b8;">Inicio</div>
                    <div style="font-size:13px;font-weight:700;color:#0f172a;">${esc(firstDateFormatted) || '—'}</div>
                </div>
                <div style="flex:1;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:8px 10px;">
                    <div style="font-size:10px;font-weight:800;text-transform:uppercase;color:#94a3b8;">Último</div>
                    <div style="font-size:13px;font-weight:700;color:#0f172a;">${esc(lastDateFormatted) || '—'}</div>
                </div>
            </div>
        </div>

        <!-- Stepper -->
        <div style="margin-top:22px;padding:4px 8px;">${buildPdfStepper(stage)}</div>

        <!-- Timeline -->
        <div style="margin-top:24px;">
            <div style="font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#94a3b8;margin-bottom:10px;">Historial del envío</div>
            ${rows}
        </div>

        <!-- Footer -->
        <div style="margin-top:24px;border-top:1px solid #e2e8f0;padding-top:14px;display:flex;align-items:center;justify-content:space-between;">
            <span style="font-size:12px;font-weight:800;color:#4f46e5;">NOVOGAR</span>
            <span style="font-size:11px;color:#94a3b8;">novogar.com.ar · Envíos Andreani</span>
        </div>`;
    return root;
}

function downloadPdf() {
    const element = buildPdfElement();
    if (!element) return;

    const holder = document.createElement('div');
    holder.style.cssText = 'position:fixed;left:-10000px;top:0;';
    holder.appendChild(element);
    document.body.appendChild(holder);

    const trackingNumber = (lastTracking && lastTracking.trackingNumber) || trackingInput.value.trim();
    const opt = {
        margin: [0.4, 0.4, 0.4, 0.4],
        filename: `Seguimiento_Novogar_${trackingNumber}.pdf`,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false },
        jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'] },
    };

    html2pdf().from(element).set(opt).save()
        .then(() => document.body.removeChild(holder))
        .catch((err) => { console.error('Error generando PDF:', err); if (holder.parentNode) document.body.removeChild(holder); });
}

/* ------------------------------ Eventos UI -------------------------------- */
async function buscar() {
    const trackingNumber = trackingInput.value.trim();
    if (!trackingNumber) {
        openResult();
        clearSections();
        hideSpinner();
        showError();
        return;
    }
    openResult();
    clearSections();
    showSpinner();
    await getAuthToken();
    if (authToken) {
        await fetchTrackingData(trackingNumber);
    } else {
        hideSpinner();
        showError();
    }
}

searchBtn.addEventListener('click', buscar);
trackingInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); buscar(); }
});

document.addEventListener('DOMContentLoaded', function () {
    const trackingNumber = new URLSearchParams(window.location.search).get('trackingNumber');
    if (trackingNumber) {
        trackingInput.value = trackingNumber;
        buscar();
    }
});
