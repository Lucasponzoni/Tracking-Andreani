/* =========================================================================
   NOVOGAR · Seguimiento de envíos Andreani
   - Proxy CORS propio en Vercel (reemplaza a proxy.cors.sh)
   - UI: Tailwind · temas claro/oscuro · status hero + stepper + timeline
   ========================================================================= */

const PROXY = 'https://novogar-cors-proxy.vercel.app/';
const proxied = (url) => `${PROXY}?u=${encodeURIComponent(url)}`;

const LOGIN_URL = 'https://apis.andreani.com/login';
const username = 'novogar_gla';
const password = 'JoBOraCDJZC';

let authToken = '';
let lastTracking = null; // datos para el PDF

/* ----------------------------- Referencias DOM ---------------------------- */
const trackingInput = document.getElementById('tracking-input');
const searchBtn = document.getElementById('search-btn');
const resultSection = document.getElementById('result');
const spinnerEl = document.getElementById('spinner');
const statusHeroEl = document.getElementById('status-hero');
const stepperEl = document.getElementById('stepper');
const actionsEl = document.getElementById('actions');
const constanciaEl = document.getElementById('constancia');
const pdfBtnContainer = document.getElementById('pdf-btn-container');
const timelineEl = document.getElementById('timeline');
const brandBlockEl = document.getElementById('brand-block');
const errorBoxEl = document.getElementById('error-box');

/* -------------------------------- Tema ------------------------------------ */
document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) { /* ignore */ }
});

/* ------------------------------ Helpers UI -------------------------------- */
function showSpinner() { if (spinnerEl) spinnerEl.style.display = 'flex'; }
function hideSpinner() { if (spinnerEl) spinnerEl.style.display = 'none'; }

function clearSections() {
    statusHeroEl.innerHTML = '';
    stepperEl.innerHTML = '';
    constanciaEl.innerHTML = '';
    pdfBtnContainer.innerHTML = '';
    timelineEl.innerHTML = '';
    brandBlockEl.innerHTML = '';
    errorBoxEl.innerHTML = '';
    errorBoxEl.classList.add('hidden');
    actionsEl.classList.remove('hidden');
}

function openResult() { resultSection.classList.remove('hidden'); }

/* --------------------------- Autenticación -------------------------------- */
async function getAuthToken() {
    try {
        const response = await fetch(proxied(LOGIN_URL), {
            method: 'GET',
            headers: { 'Authorization': `Basic ${btoa(`${username}:${password}`)}` }
        });
        if (response.ok) {
            authToken = (await response.json()).token;
        } else {
            console.error('Error al obtener el token:', response.status);
        }
    } catch (error) {
        console.error('Error al obtener el token:', error);
    }
}

/* --------------------------- Datos de trazas ------------------------------ */
async function fetchTrackingData(trackingNumber) {
    const trazasUrl = `https://apis.andreani.com/v2/envios/${trackingNumber}/trazas`;
    try {
        openResult();
        clearSections();
        showSpinner();

        const response = await fetch(proxied(trazasUrl), {
            headers: { 'x-authorization-token': authToken }
        });

        if (response.ok) {
            const data = await response.json();
            updateTrackingInfo(data.eventos || []);
            await fetchMultimedia(trackingNumber);
            createPdfButton();
        } else {
            console.error('Error de seguimiento:', response.status);
            showError();
        }
    } catch (error) {
        console.error('Error de seguimiento:', error);
        showError();
    } finally {
        hideSpinner();
    }
}

/* ------------------------------ Mensaje error ----------------------------- */
function showError() {
    statusHeroEl.innerHTML = '';
    stepperEl.innerHTML = '';
    constanciaEl.innerHTML = '';
    pdfBtnContainer.innerHTML = '';
    timelineEl.innerHTML = '';
    brandBlockEl.innerHTML = '';
    actionsEl.classList.add('hidden');
    lastTracking = null;

    errorBoxEl.classList.remove('hidden');
    errorBoxEl.innerHTML = `
        <div class="flex flex-col items-center gap-4 rounded-3xl bg-white dark:bg-slate-800 p-8 text-center
                    shadow-xl ring-1 ring-slate-100 dark:ring-slate-700">
            <span class="grid h-16 w-16 place-items-center rounded-2xl bg-rose-500 text-3xl text-white">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </span>
            <p class="text-lg font-semibold">No localizamos datos con esa guía</p>
            <p class="text-sm text-slate-500 dark:text-slate-400">Corroborá el número de seguimiento e intentá de nuevo.</p>
            <img src="./img/error.gif" alt="error" class="w-64 max-w-full rounded-xl">
        </div>`;
}

/* ----------------------- Etapa del envío (stepper) ------------------------ */
function deriveStage(events) {
    const txt = (events || [])
        .map(e => [e.Estado, e.Traduccion, e.Comentario, e.Motivo].filter(Boolean).join(' '))
        .join(' || ')
        .toLowerCase();

    const incident = /devuelto|anulad|siniestrad/.test(txt);
    const delivered = /entregado|rendici|rendido|p1d1|al20/.test(txt);

    let index;
    if (delivered) index = 4;
    else if (/reparto|distribuci|coordina|entregar dia|en camino|asignado de entrega/.test(txt)) index = 3;
    else if (/viaje|tr[áa]nsito|consolidaci|circunvalacion|destino/.test(txt)) index = 2;
    else if (/planta|recepcion|circuito|ingreso/.test(txt)) index = 1;
    else index = 0;

    return { index, incident, delivered };
}

/* ------------------------------- Status hero ------------------------------ */
function renderStatusHero(stage) {
    const { trackingNumber, statusMessage, firstDateFormatted, lastDateFormatted, lastEstado } = lastTracking;

    let accentBg, accentText, icon, kicker, title;
    if (stage.delivered) {
        accentBg = 'bg-ok'; accentText = 'text-ok'; icon = 'bi-check2-circle'; kicker = 'Entregado';
        title = '¡Envío entregado!';
    } else if (stage.incident) {
        accentBg = 'bg-rose-500'; accentText = 'text-rose-500'; icon = 'bi-exclamation-triangle-fill'; kicker = 'Atención';
        title = lastEstado || 'Revisar envío';
    } else {
        accentBg = 'bg-brand'; accentText = 'text-brand dark:text-accent'; icon = 'bi-truck'; kicker = 'En curso';
        title = ['Etiqueta generada', 'En planta Andreani', 'En viaje a destino', 'En reparto', '¡Entregado!'][stage.index];
    }

    statusHeroEl.innerHTML = `
        <div class="overflow-hidden rounded-3xl bg-white dark:bg-slate-800 shadow-xl ring-1 ring-slate-100 dark:ring-slate-700">
            <div class="flex items-center gap-4 p-5 sm:p-6">
                <span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl text-3xl text-white ${accentBg} shadow-lg">
                    <i class="bi ${icon}"></i>
                </span>
                <div class="min-w-0">
                    <div class="text-xs font-bold uppercase tracking-wide ${accentText}">${kicker}</div>
                    <h2 class="text-xl font-extrabold sm:text-2xl">${escapeHtml(title)}</h2>
                    <div class="mt-1.5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-700
                                px-3 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
                        <i class="bi bi-upc"></i> ${escapeHtml(trackingNumber)}
                    </div>
                </div>
            </div>
            ${statusMessage ? `
            <div class="border-t border-slate-100 dark:border-slate-700 px-5 sm:px-6 py-3
                        text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                ${escapeHtml(statusMessage)}
            </div>` : ''}
            <div class="grid grid-cols-2 gap-px bg-slate-100 dark:bg-slate-700 text-center">
                <div class="bg-white dark:bg-slate-800 px-3 py-3">
                    <div class="text-[11px] font-bold uppercase tracking-wide text-slate-400">Inicio</div>
                    <div class="text-sm font-semibold">${escapeHtml(firstDateFormatted) || '—'}</div>
                </div>
                <div class="bg-white dark:bg-slate-800 px-3 py-3">
                    <div class="text-[11px] font-bold uppercase tracking-wide text-slate-400">Último</div>
                    <div class="text-sm font-semibold">${escapeHtml(lastDateFormatted) || '—'}</div>
                </div>
            </div>
        </div>`;
}

/* --------------------------------- Stepper -------------------------------- */
function renderStepper(stage) {
    const steps = [
        { label: 'Generado', icon: 'bi-upc-scan' },
        { label: 'En planta', icon: 'bi-buildings' },
        { label: 'En viaje', icon: 'bi-truck' },
        { label: 'En reparto', icon: 'bi-bicycle' },
        { label: 'Entregado', icon: 'bi-check2-circle' },
    ];

    const delivered = stage.delivered;
    // En curso → naranja. Entregado → verde.
    const reachedColor = delivered ? 'bg-ok' : 'bg-orange-500';
    const lineColor = delivered ? 'bg-ok' : 'bg-orange-500';
    const filledPct = (stage.index / (steps.length - 1)) * 80; // pista va de 10% a 90%

    const nodes = steps.map((s, i) => {
        const reached = i <= stage.index;
        const current = i === stage.index;
        const circle = reached ? `${reachedColor} text-white` : 'bg-slate-100 dark:bg-slate-700 text-slate-400';
        const labelCls = reached ? 'text-slate-700 dark:text-slate-200' : 'text-slate-400 dark:text-slate-500';
        // Anillo animado solo en el paso actual y si NO está entregado.
        const ring = (current && !delivered)
            ? '<span class="absolute inline-flex h-9 w-9 animate-ping rounded-full bg-orange-400 opacity-60"></span>'
            : '';
        return `
            <div class="relative z-10 flex flex-1 flex-col items-center gap-2 text-center">
                <span class="relative grid h-9 w-9 place-items-center">
                    ${ring}
                    <span class="relative grid h-9 w-9 place-items-center rounded-full text-base transition-colors ${circle}">
                        <i class="bi ${s.icon}"></i>
                    </span>
                </span>
                <span class="text-[10px] font-bold uppercase leading-tight sm:text-[11px] ${labelCls}">${s.label}</span>
            </div>`;
    }).join('');

    stepperEl.innerHTML = `
        <div class="rounded-3xl bg-white dark:bg-slate-800 p-5 shadow-xl ring-1 ring-slate-100 dark:ring-slate-700">
            <div class="relative">
                <div class="absolute left-[10%] right-[10%] top-[18px] h-0.5 bg-slate-200 dark:bg-slate-700"></div>
                <div class="absolute left-[10%] top-[18px] h-0.5 ${lineColor} transition-all duration-500" style="width:${filledPct}%"></div>
                <div class="relative flex items-start justify-between">${nodes}</div>
            </div>
        </div>`;
}

/* ------------------------------- Multimedia ------------------------------- */
async function fetchMultimedia(trackingNumber) {
    const multimediaUrl = `https://apis.andreani.com/v1/envios/${trackingNumber}/multimedia`;
    try {
        const response = await fetch(proxied(multimediaUrl), {
            headers: { 'x-authorization-token': authToken }
        });

        if (response.ok) {
            const data = await response.json();
            if (data.multimedia && data.multimedia.length > 0) {
                const link = data.multimedia[0].cotenido;
                if (lastTracking) lastTracking.multimediaLink = link;
                constanciaEl.innerHTML = `
                    <a href="${link}" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-2 rounded-xl bg-slate-800 dark:bg-slate-700 px-4 py-3
                              font-semibold text-white shadow hover:bg-slate-900 dark:hover:bg-slate-600 transition-colors">
                        <i class="bi bi-file-earmark-medical-fill"></i> Constancia de entrega
                    </a>`;
            } else {
                constanciaEl.innerHTML = `
                    <p class="inline-flex items-center gap-2 rounded-xl bg-slate-100 dark:bg-slate-800 px-4 py-3
                              text-sm font-medium text-slate-500 dark:text-slate-400">
                        <i class="bi bi-clock-history"></i> Constancia disponible dentro de las 96 hs de entregado
                    </p>`;
            }
        } else {
            console.error('Error multimedia:', response.status);
        }
    } catch (error) {
        console.error('Error multimedia:', error);
    }
}

/* ------------------------- Botón de descarga PDF -------------------------- */
function createPdfButton() {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'inline-flex items-center gap-2 rounded-xl bg-brand px-4 py-3 font-semibold text-white ' +
        'shadow-lg shadow-brand/25 hover:bg-brand-dark active:scale-95 transition-colors';
    btn.innerHTML = '<i class="bi bi-file-earmark-pdf-fill"></i> Descargar PDF';
    btn.addEventListener('click', downloadPdf);
    pdfBtnContainer.appendChild(btn);
}

/* ------------------------------ Formato fecha ----------------------------- */
function formatFecha(fechaString) {
    const fecha = new Date(fechaString);
    const meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const dia = fecha.getDate();
    const mes = meses[fecha.getMonth()];
    const anio = fecha.getFullYear();
    const hh = String(fecha.getHours()).padStart(2, '0');
    const mm = String(fecha.getMinutes()).padStart(2, '0');
    return `${dia} de ${mes} de ${anio} · ${hh}:${mm} hs`;
}

function formatFechaCorta(fecha) {
    return new Date(fecha).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
}

function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/* ----------------- Render principal de la información ---------------------- */
function updateTrackingInfo(trackingEvents) {
    const trackingNumber = trackingInput.value.trim();

    lastTracking = {
        trackingNumber,
        events: trackingEvents || [],
        statusMessage: '',
        firstDateFormatted: '',
        lastDateFormatted: '',
        lastEstado: '',
        multimediaLink: null,
    };

    const validEvents = (trackingEvents || []).filter(e => e.Estado !== 'Pendiente de ingreso');

    if (validEvents.length > 0) {
        const firstEvent = validEvents[0];
        const lastEvent = validEvents[validEvents.length - 1];
        const firstDate = new Date(firstEvent.Fecha);
        const lastDate = new Date(lastEvent.Fecha);
        const currentDate = new Date();

        const daysInTransit = calcularDiasHabiles(firstDate, currentDate);
        const daysBetweenFirstAndLast = calcularDiasHabiles(firstDate, lastDate);

        let statusMessage = '';
        if (lastEvent.Estado === 'Entregado' || lastEvent.Estado === 'Rendición') {
            statusMessage = `La unidad fue entregada con éxito en ${daysBetweenFirstAndLast} días hábiles.`;
        } else if (lastEvent.Estado === 'Siniestrado') {
            statusMessage = `La unidad fue siniestrada a los ${daysBetweenFirstAndLast} días hábiles, contactar a Posventa.`;
        } else if (daysInTransit <= 10) {
            const daysLeft = 10 - daysInTransit;
            statusMessage = `El envío se encuentra en plazo, lleva ${daysInTransit} días hábiles en viaje, restan ${daysLeft} días hábiles para que pase a demora.`;
        } else if (lastEvent.Estado === 'Devuelto') {
            statusMessage = `La unidad fue Devuelta a los ${daysBetweenFirstAndLast} días hábiles, contactar a Posventa para analizar reenvio o reintegro de dinero.`;
        } else if (lastEvent.Estado === 'Anulado') {
            statusMessage = `La unidad fue Anulada a los ${daysBetweenFirstAndLast} días hábiles, contactar a Posventa.`;
        } else {
            const delayDays = daysInTransit - 10;
            statusMessage = `La unidad se encuentra fuera del plazo normal de entrega, lleva ${daysInTransit} días hábiles en viaje, contactar a Posventa ya que posee ${delayDays} días hábiles de demora.`;
        }

        lastTracking.statusMessage = statusMessage;
        lastTracking.firstDateFormatted = formatFechaCorta(firstEvent.Fecha);
        lastTracking.lastDateFormatted = formatFechaCorta(lastEvent.Fecha);
        lastTracking.lastEstado = lastEvent.Estado;
    }

    const stage = deriveStage(trackingEvents);
    renderStatusHero(stage);
    renderStepper(stage);
    renderTimeline(trackingEvents);
    renderBrandBlock();
}

/* --------------------------------- Timeline ------------------------------- */
function renderTimeline(trackingEvents) {
    timelineEl.innerHTML = '';

    const wrap = document.createElement('div');
    wrap.className = 'rounded-3xl bg-white dark:bg-slate-800 p-5 sm:p-6 shadow-xl ring-1 ring-slate-100 dark:ring-slate-700';

    const heading = document.createElement('h3');
    heading.className = 'mb-4 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-400';
    heading.innerHTML = '<i class="bi bi-clock-history"></i> Historial del envío';
    wrap.appendChild(heading);

    let esperandoConsolidacionCount = 0;
    let isFirstItem = true;

    for (let i = trackingEvents.length - 1; i >= 0; i--) {
        const evento = trackingEvents[i];
        const isLast = i === 0;

        const row = document.createElement('div');
        row.className = `relative pl-9 ${isLast ? '' : 'pb-5'}`;

        // Línea conectora
        if (!isLast) {
            const line = document.createElement('span');
            line.className = 'pointer-events-none absolute left-[13px] top-6 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-700';
            row.appendChild(line);
        }
        // Punto
        const dot = document.createElement('span');
        if (isFirstItem) {
            dot.className = 'pointer-events-none absolute left-0 top-1 grid h-7 w-7 place-items-center rounded-full bg-ok text-xs text-white ring-4 ring-white dark:ring-slate-800';
            dot.innerHTML = '<i class="bi bi-check-lg"></i>';
        } else {
            dot.className = 'pointer-events-none absolute left-1.5 top-2 h-4 w-4 rounded-full bg-brand ring-4 ring-white dark:ring-slate-800';
        }
        row.appendChild(dot);

        // Tarjeta del evento
        const card = document.createElement('div');
        card.className = isFirstItem
            ? 'rounded-2xl border border-ok/40 bg-emerald-50 dark:bg-emerald-900/20 p-4'
            : 'rounded-2xl bg-slate-50 dark:bg-slate-700/40 p-4 ring-1 ring-slate-100 dark:ring-slate-700';

        // Motivo
        if (evento.Motivo) {
            const reason = document.createElement('div');
            reason.className = 'mb-1 text-xs text-slate-400';
            reason.textContent = evento.Motivo;
            card.appendChild(reason);
        }

        // Fecha
        const dateEl = document.createElement('div');
        dateEl.className = isFirstItem
            ? 'mb-1.5 text-xs font-bold uppercase tracking-wide text-ok'
            : 'mb-1.5 text-xs font-semibold text-slate-400';
        dateEl.innerHTML = '<i class="bi bi-calendar3 mr-1"></i>';
        dateEl.appendChild(document.createTextNode(formatFecha(evento.Fecha)));

        // Estado (badge)
        const statusEl = document.createElement('span');
        statusEl.className = isFirstItem
            ? 'mb-1 inline-flex w-fit items-center gap-1 rounded-lg bg-ok px-2.5 py-1 text-sm font-bold uppercase text-white'
            : 'mb-1 inline-flex w-fit items-center rounded-lg bg-slate-200 px-2.5 py-1 text-sm font-bold uppercase text-slate-700 dark:bg-slate-600 dark:text-slate-100';
        statusEl.textContent = evento.Estado;

        // Traducción / detalle
        const status2El = document.createElement('div');
        status2El.className = 'mt-1 w-fit text-sm font-semibold uppercase text-brand dark:text-accent';
        if (!evento.Traduccion) status2El.classList.add('hidden');
        else status2El.textContent = evento.Traduccion;

        // Ciclo
        const status3El = document.createElement('div');
        status3El.className = 'mt-1.5 w-fit rounded-md bg-indigo-100 px-2.5 py-1 text-xs font-semibold uppercase text-brand dark:bg-indigo-950/40 dark:text-accent';
        if (!evento.Ciclo) status3El.classList.add('hidden');
        else status3El.textContent = `Ciclo actual: ${evento.Ciclo}`;

        // Sucursal / ubicación
        const locEl = document.createElement('div');
        locEl.className = 'mt-1.5 flex items-start gap-1 text-xs font-semibold uppercase text-slate-400';
        let locText;
        if (evento.Sucursal === 'Sucursal Genérica') locText = 'DEPÓSITO CENTRAL NOVOGAR, ROSARIO';
        else if (evento.Sucursal === 'Centro De Operaciones' || evento.Sucursal === 'Rosario' || evento.Sucursal === '9') locText = 'PLANTA LOGÍSTICA CORREO ANDREANI, ROSARIO';
        else locText = evento.Sucursal || '';

        // Normalización de estado (lógica de negocio original)
        if (!status2El.textContent) {
            const statusCases = { 'Ingreso al circuito operativo': 'ENVIO RECEPCIONADO EN PLANTA' };
            if (statusCases[statusEl.textContent]) {
                status2El.textContent = statusCases[statusEl.textContent]; status2El.classList.remove('hidden');
            } else if (statusEl.textContent === 'Indefinido') {
                if (evento.Comentario && evento.Comentario.startsWith('Entregar dia')) {
                    status2El.textContent = 'TURNO ASIGNADO DE ENTREGA'; status2El.classList.remove('hidden');
                } else if (evento.Comentario && evento.Comentario.startsWith('FAC')) {
                    statusEl.textContent = 'RENDIDO';
                    status2El.textContent = 'ENTREGADO Y FACTURADO, REMITO EN VIAJE A NOVOGAR'; status2El.classList.remove('hidden');
                } else {
                    status2El.innerHTML = '<i class="bi bi-send-plus-fill"></i>'; status2El.classList.remove('hidden');
                }
            } else if (!evento.Estado && !evento.Traduccion && !evento.Sucursal && !evento.SucursalId && !evento.Motivo && evento.Fecha) {
                status2El.innerHTML = '<i class="bi bi-clock-fill"></i> GENERAMOS LA ETIQUETA DE ENVIO'; status2El.classList.remove('hidden');
            }
        }
        if (evento.Motivo === 'p1D1' || evento.Motivo === 'AL20') {
            status2El.innerHTML = '<i class="bi bi-check-circle-fill"></i> ENTREGADO'; status2El.classList.remove('hidden');
        }
        if (statusEl.textContent === 'ESPERANDO CONSOLIDACION') {
            esperandoConsolidacionCount++;
            if (esperandoConsolidacionCount === 3) {
                status2El.innerHTML = '<i class="bi bi-box-seam-fill"></i> YA TENEMOS TU PAQUETE'; status2El.classList.remove('hidden');
                locText = 'PLANTA ROSARIO CIRCUNVALACION';
            } else if (esperandoConsolidacionCount === 2) {
                status2El.innerHTML = '<i class="bi bi-truck"></i> TU PAQUETE VIAJA A DESTINO'; status2El.classList.remove('hidden');
                locText = 'PLANTA ROSARIO CIRCUNVALACION';
            } else if (esperandoConsolidacionCount === 1) {
                if (evento.Sucursal === '9') {
                    status2El.innerHTML = '<i class="bi bi-truck"></i> TU PAQUETE CONTINUA VIAJANDO A DESTINO';
                    locText = 'PLANTA ROSARIO CIRCUNVALACION';
                } else {
                    status2El.innerHTML = '<i class="bi bi-lightning-charge-fill"></i> TU PAQUETE LLEGO A PLANTA';
                }
                status2El.classList.remove('hidden');
            }
        }

        // Comentario
        let commentEl = null;
        if (evento.Comentario) {
            commentEl = document.createElement('div');
            commentEl.className = 'mt-1.5 text-sm text-slate-600 dark:text-slate-300';
            if (evento.Comentario.startsWith('Rep.')) {
                commentEl.textContent = evento.Comentario.replace('Rep.', 'Repartidor Asignado:');
            } else if (evento.Comentario.startsWith('Entregar dia')) {
                statusEl.textContent = 'Se coordina turno de entrega';
                commentEl.textContent = evento.Comentario;
            } else {
                commentEl.textContent = evento.Comentario;
            }
        }

        // Ubicación final
        if (evento.SucursalId) locText += `, Id Sucursal: ${evento.SucursalId}`;
        if (locText) {
            locEl.innerHTML = '<i class="bi bi-geo-alt-fill mt-0.5"></i>';
            locEl.appendChild(document.createTextNode(locText));
        } else {
            locEl.classList.add('hidden');
        }

        // Ensamblar tarjeta
        card.appendChild(dateEl);
        card.appendChild(statusEl);
        card.appendChild(status2El);
        card.appendChild(status3El);
        if (commentEl) card.appendChild(commentEl);
        card.appendChild(locEl);

        row.appendChild(card);
        wrap.appendChild(row);

        isFirstItem = false;
    }

    timelineEl.appendChild(wrap);
}

/* ----------------------------- Bloque de marca ---------------------------- */
function renderBrandBlock() {
    brandBlockEl.innerHTML = `
